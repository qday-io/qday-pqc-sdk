LIBOQS_INCLUDE_DIR=/opt/homebrew/include
LIBOQS_LIB_DIR=/opt/homebrew/lib
OPENSSL_LIB_DIR=/opt/homebrew/opt/openssl@3/lib

Name: liboqs-go
Description: Go bindings for liboqs, a C library for quantum resistant cryptography
Version: 0.16.0
Cflags: -I${LIBOQS_INCLUDE_DIR}
Ldflags: '-extldflags "-Wl,-stack_size -Wl,0x1000000"'
Libs: -L${LIBOQS_LIB_DIR} -loqs -L${OPENSSL_LIB_DIR} -lcrypto
